            $('.row-no-shipment').each(function() {
                var noShipment = $(this).val() ? $(this).val().trim() : '';
                if (noShipment !== '') {
                    var currentRow = $(this).closest('tr');
                    var muatan = parseFloat(currentRow.find('.row-nilai-muatan').val()) || 0;
                    var biaya = parseFloat(currentRow.find('.row-biaya-kirim').val()) || 0;

                    if (!shipmentGroups[noShipment]) {
                        shipmentGroups[noShipment] = {
                            totalMuatan: 0,
                            totalBiaya: 0,
                            rows: [] // Menyimpan semua baris yang memiliki No Shipment yang sama
                        };
                    }

                    shipmentGroups[noShipment].totalMuatan += muatan;
                    shipmentGroups[noShipment].totalBiaya += biaya;
                    shipmentGroups[noShipment].rows.push(currentRow);
                }
            });

            // Langkah 2: Hitung CR (%) dan tembak nilainya HANYA ke baris pertama (index 0)
            $.each(shipmentGroups, function(noShipment, data) {
                var hasilCr = 0;
                if (data.totalMuatan > 0) {
                    hasilCr = (data.totalBiaya / data.totalMuatan) * 100;
                }

                // Loooping baris di dalam grup shipment ini
                $.each(data.rows, function(index, row) {
                    if (index === 0) {
                        // Jika baris pertama, isi dengan hasil kalkulasi CR asli
                        row.find('.row-cr').val(hasilCr.toFixed(2));
                    } else {
                        // Jika baris ke-2, ke-3 (duplikat), kosongkan input CR-nya
                        row.find('.row-cr').val('');
                    }
                });
            });
        }

        // Trigger kalkulasi secara instant ketika user sedang mengetik/mengubah angka di kolom tabel
        $(document).on('input', '.row-nilai-muatan, .row-biaya-kirim', function() {
            hitungSemuaCostRatioTabel();
        });
        $(document).on('change', '.row-no-shipment', function() {
            hitungSemuaCostRatioTabel();
        });

        // ========================================================
        // RUMUS MODAL: "ADD NEW SHIPMENT"
        // ========================================================
        $(document).on('input', '.modal-nilai-muatan, .modal-biaya-kirim', function() {
