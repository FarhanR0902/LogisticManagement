<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
}

body{
    background:#f8fafc;
    color:#334155;
    font-size:17px;
}

/* ===========================
   CONTAINER
=========================== */

.container-fluid-custom{
    width:calc(100% - 260px);
    margin-left:260px;
    padding:40px;
}

/* ===========================
   PAGE HEADER
=========================== */

.page-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:35px;
}

.title{
    font-size:40px;
    font-weight:700;
    color:#1e293b;
    position:relative;
}

.title::after{
    content:'';
    display:block;
    width:75px;
    height:5px;
    background:#0284c7;
    border-radius:10px;
    margin-top:8px;
}

/* ===========================
   CARD
=========================== */

.card{
    background:#fff;
    border-radius:18px;
    border:none;
    padding:30px;
    box-shadow:0 8px 25px rgba(0,0,0,.08);
}

/* ===========================
   DATATABLES
=========================== */

.dataTables_wrapper{
    padding-top:20px;
    font-size:17px;
}

.dataTables_length,
.dataTables_filter,
.dataTables_info,
.dataTables_paginate{
    font-size:17px;
}

.dataTables_length label,
.dataTables_filter label{
    font-size:17px;
    font-weight:600;
}

.dataTables_filter input{
    height:45px;
    font-size:16px;
    padding:8px 14px;
    border-radius:8px;
    border:1px solid #cbd5e1;
}

.dataTables_length select{
    height:45px;
    font-size:16px;
    border-radius:8px;
    padding:6px 10px;
}

.dataTables_paginate .paginate_button{
    font-size:16px !important;
    padding:8px 14px !important;
}

/* ===========================
   TABLE
=========================== */

table.dataTable{
    width:100% !important;
    border-collapse:collapse !important;
    font-size:17px;
}

table.dataTable thead th{

    padding:18px 16px !important;

    text-align:center;

    vertical-align:middle;

    font-size:16px;

    white-space:nowrap;
}

table.dataTable tbody tr{

    background:#fff;

    transition:.2s;
}

table.dataTable tbody tr:hover{

    background:#f1f5f9 !important;
}

table.dataTable tbody td{

    padding:16px 14px !important;

    font-size:16px;

    vertical-align:middle;

    border-bottom:1px solid #e2e8f0 !important;

    color:#475569;

    white-space:nowrap;
}

/* ===========================
   INPUT TABLE
=========================== */

table input[type=text],
table input[type=number],
table input[type=datetime-local],
table select{

    width:180px;

    padding:10px 12px;

    border:1px solid #cbd5e1;

    border-radius:8px;

    font-size:15px;

    background:#fff;

    transition:.2s;
}

table input[type=datetime-local]{

    width:220px;
}

table input:focus,
table select:focus{

    border-color:#38bdf8;

    outline:none;

    box-shadow:0 0 0 3px rgba(56,189,248,.20);
}

/* ===========================
   STATUS BADGE
=========================== */

.badge-status{

    padding:8px 16px;

    border-radius:30px;

    font-size:14px;

    font-weight:700;

    display:inline-block;

    min-width:90px;

    text-align:center;
}

/* ===========================
   MODAL
=========================== */

.form-horizontal-scroll{

    overflow-x:auto;

    display:flex;

    gap:20px;

    padding-bottom:20px;
}

.form-horizontal-scroll .field-box{

    flex:0 0 300px;
}

.form-horizontal-scroll label{

    font-size:16px;

    font-weight:600;

    color:#475569;

    margin-bottom:8px;

    display:block;
}

.form-horizontal-scroll .form-control{

    height:48px;

    font-size:16px;

    border-radius:8px;

    border:1px solid #cbd5e1;
}

/* ===========================
   BUTTON
=========================== */

.btn-action{

    display:flex;

    gap:8px;

    justify-content:center;

    align-items:center;
}

button,
.btn{

    font-size:16px;

    padding:10px 18px;

    border-radius:8px;
}

/* ===========================
   TABLE HEADER COLOR
=========================== */

th.th-default{

    background:#00d0ff !important;

    color:#fff !important;

    font-size:16px;

    font-weight:700;

    text-align:center;

    vertical-align:middle;

    letter-spacing:.5px;

    padding:18px 12px !important;
}

th.th-edit{

    background:#00ffa2 !important;

    color:#111827 !important;

    font-size:16px;

    font-weight:700;

    text-align:center;

    vertical-align:middle;

    letter-spacing:.5px;

    padding:18px 12px !important;
}

th.th-system{

    background:#2563eb !important;

    color:#fff !important;

    font-size:16px;

    font-weight:700;

    text-align:center;

    vertical-align:middle;

    letter-spacing:.5px;

    padding:18px 12px !important;
}

.th-oren{

    background:#ff9800 !important;

    color:#fff !important;

    font-size:16px;

    font-weight:700;

    text-align:center;

    padding:18px 12px !important;
}

/* ===========================
   COLORS
=========================== */

.bg-orange{

    background:#fd7e14 !important;

    color:#fff;
}

/* ===========================
   INPUT STATUS
=========================== */

.input-filled{

    background:#dcfce7 !important;

    border:2px solid #22c55e !important;

    color:#166534 !important;

    font-size:15px;

    font-weight:700;
}

.input-empty{

    background:#fef2f2 !important;

    border:2px solid #ef4444 !important;

    color:#991b1b !important;

    font-size:15px;

    font-weight:700;
}

/* ===========================
   RESPONSIVE
=========================== */

@media(max-width:1400px){

    .container-fluid-custom{
        padding:30px;
    }

    .title{
        font-size:34px;
    }

    table.dataTable{
        font-size:15px;
    }
}

@media(max-width:992px){

    .container-fluid-custom{

        width:100%;

        margin-left:0;

        padding:20px;
    }

    .title{

        font-size:30px;
    }

    table.dataTable{

        display:block;

        overflow-x:auto;
    }
}
</style>